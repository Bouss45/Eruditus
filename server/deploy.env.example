# Modèle de server/deploy.env (non versionné), lu par deploy.sh et questions.sh
# (spec/serveur.md § 9). Copie ce fichier en server/deploy.env et remplace chaque valeur par la
# tienne. Aucun identifiant ni détail de l'installation dans ce dépôt public : l'alias SSH renvoie
# à ta configuration SSH (~/.ssh/config), avec un utilisateur qui peut lancer sudo -n (D36).

# Alias SSH du VPS.
HOTE=mon-vps
# Conteneur Docker de PocketBase.
CONTENEUR=nom-du-conteneur
# Dossier du VPS qui contient pb_migrations/ et pb_hooks/, montés en lecture seule dans le
# conteneur (D37).
DOSSIER_VPS=/chemin/vers/eruditus
# Dossier des archives de deploy.sh, créé au premier déploiement, lisible par root seul (D38).
SAUVEGARDES=/chemin/vers/sauvegardes
# Adresse publique du serveur, en https://.
URL=https://pocketbase.example.com
